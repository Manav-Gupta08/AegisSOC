# AegisSOC local configuration. Copy is created by `aegis init-secrets`; never commit `.env`.
# Values must be plain KEY=VALUE without quotes. Do not use `$` in values.

# --- Generated secrets (leave empty here; `aegis init-secrets` fills .env) ---
INDEXER_ADMIN_PASSWORD=
INDEXER_KIBANASERVER_PASSWORD=
INDEXER_READER_PASSWORD=
WAZUH_API_WUI_PASSWORD=
WAZUH_API_WAZUH_PASSWORD=
WAZUH_API_READER_PASSWORD=
WAZUH_ENROLLMENT_PASSWORD=

# --- Network binding ---
# Address the agent ports (1514/1515) are published on. Keep 127.0.0.1 unless an endpoint
# cannot reach localhost; then use the host's lab-only adapter IP, never 0.0.0.0.
AEGIS_AGENT_BIND=127.0.0.1
AEGIS_DASHBOARD_PORT=5601

# --- Health thresholds ---
AEGIS_DISK_WARN_PERCENT=75
AEGIS_DISK_FAIL_PERCENT=85
AEGIS_ALERT_STALE_MINUTES=60
